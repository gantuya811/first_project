# ============================================================
# MERRIGE ERP - Орчны тохиргооны жишээ файл
# Энэ файлыг ".env" нэрээр хуулж, өөрийн утгуудаар бөглөнө үү.
# ============================================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Production - PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=merrige_erp
DB_USER=merrige_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Cache / Celery broker) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Email (мэдэгдэл илгээхэд ашиглана) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MERRIGE ERP <no-reply@merrige.mn>

# --- CORS / Domain ---
SITE_DOMAIN=http://127.0.0.1:8000

# --- Docker/Production SSL (STEP17) ---
# Бодит domain+SSL сертификат (STEP18) тохируулаагүй үед docker-compose
# стекийг http://localhost-ээр локал шалгахын тулд False болгож болно.
# Бодит production дээр ЗААВАЛ True байлгана (анхдагч утга нь аль хэдийн True).
SECURE_SSL_REDIRECT=True
